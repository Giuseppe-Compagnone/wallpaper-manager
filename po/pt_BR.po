"Language: pt_BR\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Wallpaper folder"
msgstr "Pasta de papéis de parede"
msgid "Folder containing the images assigned to monitors and workspaces."
msgstr "Pasta que contém as imagens atribuídas a monitores e espaços de trabalho."
msgid "Wallpaper scaling mode"
msgstr "Modo de escala do papel de parede"
msgid "Stable random order seed"
msgstr "Semente da ordem aleatória estável"

msgid "Wallpaper Manager"
msgstr "Gerenciador de papéis de parede"
msgid "Wallpapers"
msgstr "Papéis de parede"
msgid "Every image is used once before the list repeats."
msgstr "Cada imagem é usada antes que a lista se repita."
msgid "Image folder"
msgstr "Pasta de imagens"
msgid "Choose…"
msgstr "Escolher…"
msgid "Choose a wallpaper folder"
msgstr "Escolha uma pasta de papéis de parede"
msgid "Shuffle images"
msgstr "Embaralhar imagens"
msgid "The random order stays stable until you reshuffle it."
msgstr "A ordem aleatória permanece estável até ser embaralhada novamente."
msgid "Reshuffle now"
msgstr "Embaralhar agora"
msgid "Create a new assignment for monitors and workspaces."
msgstr "Criar uma nova atribuição para monitores e espaços de trabalho."
msgid "Reshuffle"
msgstr "Embaralhar"
msgid "Appearance"
msgstr "Aparência"
msgid "Wallpaper scaling"
msgstr "Escala do papel de parede"
msgid "Fill and crop"
msgstr "Preencher e cortar"
msgid "Fit with borders"
msgstr "Ajustar com bordas"
msgid "Assignment order"
msgstr "Ordem de atribuição"
msgid "Workspace 1 · monitor 1, workspace 1 · monitor 2, then workspace 2, and so on."
msgstr "Espaço de trabalho 1 · monitor 1, espaço de trabalho 1 · monitor 2, depois espaço de trabalho 2 e assim por diante."
msgid "No folder selected"
msgstr "Nenhuma pasta selecionada"
msgid "The selected wallpaper folder could not be read."
msgstr "Não foi possível ler a pasta de papéis de parede selecionada."
msgid "No supported images were found in the selected folder."
msgstr "Nenhuma imagem compatível foi encontrada na pasta selecionada."
