"Language: es\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Wallpaper folder"
msgstr "Carpeta de fondos de pantalla"
msgid "Folder containing the images assigned to monitors and workspaces."
msgstr "Carpeta que contiene las imágenes asignadas a monitores y espacios de trabajo."
msgid "Wallpaper scaling mode"
msgstr "Modo de escalado del fondo de pantalla"
msgid "Stable random order seed"
msgstr "Semilla del orden aleatorio estable"

msgid "Wallpaper Manager"
msgstr "Gestor de fondos de pantalla"
msgid "Wallpapers"
msgstr "Fondos de pantalla"
msgid "Every image is used once before the list repeats."
msgstr "Cada imagen se usa antes de repetir la lista."
msgid "Image folder"
msgstr "Carpeta de imágenes"
msgid "Choose…"
msgstr "Elegir…"
msgid "Choose a wallpaper folder"
msgstr "Elegir una carpeta de fondos de pantalla"
msgid "Shuffle images"
msgstr "Mezclar imágenes"
msgid "The random order stays stable until you reshuffle it."
msgstr "El orden aleatorio se mantiene estable hasta que vuelvas a mezclarlo."
msgid "Reshuffle now"
msgstr "Mezclar ahora"
msgid "Create a new assignment for monitors and workspaces."
msgstr "Crear una nueva asignación para monitores y espacios de trabajo."
msgid "Reshuffle"
msgstr "Mezclar"
msgid "Appearance"
msgstr "Apariencia"
msgid "Wallpaper scaling"
msgstr "Escalado del fondo de pantalla"
msgid "Fill and crop"
msgstr "Rellenar y recortar"
msgid "Fit with borders"
msgstr "Ajustar con bordes"
msgid "Assignment order"
msgstr "Orden de asignación"
msgid "Workspace 1 · monitor 1, workspace 1 · monitor 2, then workspace 2, and so on."
msgstr "Espacio de trabajo 1 · monitor 1, espacio de trabajo 1 · monitor 2, luego espacio de trabajo 2, etc."
msgid "No folder selected"
msgstr "No se ha seleccionado ninguna carpeta"
msgid "The selected wallpaper folder could not be read."
msgstr "No se pudo leer la carpeta de fondos seleccionada."
msgid "No supported images were found in the selected folder."
msgstr "No se encontraron imágenes compatibles en la carpeta seleccionada."
