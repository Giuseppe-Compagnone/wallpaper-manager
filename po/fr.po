"Language: fr\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Wallpaper folder"
msgstr "Dossier de fonds d’écran"
msgid "Folder containing the images assigned to monitors and workspaces."
msgstr "Dossier contenant les images attribuées aux écrans et aux espaces de travail."
msgid "Wallpaper scaling mode"
msgstr "Mode de mise à l’échelle du fond d’écran"
msgid "Stable random order seed"
msgstr "Graine de l’ordre aléatoire stable"

msgid "Wallpaper Manager"
msgstr "Gestionnaire de fonds d’écran"
msgid "Wallpapers"
msgstr "Fonds d’écran"
msgid "Every image is used once before the list repeats."
msgstr "Chaque image est utilisée avant que la liste recommence."
msgid "Image folder"
msgstr "Dossier d’images"
msgid "Choose…"
msgstr "Choisir…"
msgid "Choose a wallpaper folder"
msgstr "Choisir un dossier de fonds d’écran"
msgid "Shuffle images"
msgstr "Mélanger les images"
msgid "The random order stays stable until you reshuffle it."
msgstr "L’ordre aléatoire reste stable jusqu’au prochain mélange."
msgid "Reshuffle now"
msgstr "Mélanger maintenant"
msgid "Create a new assignment for monitors and workspaces."
msgstr "Créer une nouvelle attribution pour les écrans et les espaces de travail."
msgid "Reshuffle"
msgstr "Mélanger"
msgid "Appearance"
msgstr "Apparence"
msgid "Wallpaper scaling"
msgstr "Mise à l’échelle du fond d’écran"
msgid "Fill and crop"
msgstr "Remplir et recadrer"
msgid "Fit with borders"
msgstr "Ajuster avec des bordures"
msgid "Assignment order"
msgstr "Ordre d’attribution"
msgid "Workspace 1 · monitor 1, workspace 1 · monitor 2, then workspace 2, and so on."
msgstr "Espace de travail 1 · écran 1, espace de travail 1 · écran 2, puis espace de travail 2, etc."
msgid "No folder selected"
msgstr "Aucun dossier sélectionné"
msgid "The selected wallpaper folder could not be read."
msgstr "Impossible de lire le dossier de fonds d’écran sélectionné."
msgid "No supported images were found in the selected folder."
msgstr "Aucune image compatible n’a été trouvée dans le dossier sélectionné."
