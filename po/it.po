msgid "Wallpaper folder"
msgstr "Cartella degli sfondi"
msgid "Folder containing the images assigned to monitors and workspaces."
msgstr "Cartella contenente le immagini assegnate a monitor e spazi di lavoro."
msgid "Wallpaper scaling mode"
msgstr "Modalità di adattamento degli sfondi"
msgid "Stable random order seed"
msgstr "Seme dell’ordine casuale stabile"

msgid "Wallpaper Manager"
msgstr "Wallpaper Manager"
msgid "Wallpapers"
msgstr "Sfondi"
msgid "Every image is used once before the list repeats."
msgstr "Ogni immagine viene usata una volta prima di ripetere la lista."
msgid "Image folder"
msgstr "Cartella delle immagini"
msgid "Choose…"
msgstr "Scegli…"
msgid "Choose a wallpaper folder"
msgstr "Scegli una cartella per gli sfondi"
msgid "Shuffle images"
msgstr "Mescola le immagini"
msgid "The random order stays stable until you reshuffle it."
msgstr "L’ordine casuale rimane stabile finché non lo rimescoli."
msgid "Reshuffle now"
msgstr "Rimescola ora"
msgid "Create a new assignment for monitors and workspaces."
msgstr "Crea una nuova assegnazione per monitor e spazi di lavoro."
msgid "Reshuffle"
msgstr "Rimescola"
msgid "Appearance"
msgstr "Aspetto"
msgid "Wallpaper scaling"
msgstr "Adattamento degli sfondi"
msgid "Fill and crop"
msgstr "Riempi e ritaglia"
msgid "Fit with borders"
msgstr "Adatta con bordi"
msgid "Assignment order"
msgstr "Ordine di assegnazione"
msgid "Workspace 1 · monitor 1, workspace 1 · monitor 2, then workspace 2, and so on."
msgstr "Spazio di lavoro 1 · monitor 1, spazio di lavoro 1 · monitor 2, poi spazio di lavoro 2 e così via."
msgid "No folder selected"
msgstr "Nessuna cartella selezionata"
msgid "The selected wallpaper folder could not be read."
msgstr "Impossibile leggere la cartella degli sfondi selezionata."
msgid "No supported images were found in the selected folder."
msgstr "Nella cartella selezionata non sono state trovate immagini supportate."
