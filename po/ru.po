"Content-Transfer-Encoding: 8bit\n"

msgid "Wallpaper folder"
msgstr "Папка с обоями"
msgid "Folder containing the images assigned to monitors and workspaces."
msgstr "Папка с изображениями, назначенными мониторам и рабочим пространствам."
msgid "Wallpaper scaling mode"
msgstr "Режим масштабирования обоев"
msgid "Stable random order seed"
msgstr "Начальное число стабильного случайного порядка"

msgid "Wallpaper Manager"
msgstr "Менеджер обоев"
msgid "Wallpapers"
msgstr "Обои"
msgid "Every image is used once before the list repeats."
msgstr "Каждое изображение используется до повторения списка."
msgid "Image folder"
msgstr "Папка с изображениями"
msgid "Choose…"
msgstr "Выбрать…"
msgid "Choose a wallpaper folder"
msgstr "Выберите папку с обоями"
msgid "Shuffle images"
msgstr "Перемешивать изображения"
msgid "The random order stays stable until you reshuffle it."
msgstr "Случайный порядок сохраняется до следующего перемешивания."
msgid "Reshuffle now"
msgstr "Перемешать сейчас"
msgid "Create a new assignment for monitors and workspaces."
msgstr "Создать новое назначение для мониторов и рабочих пространств."
msgid "Reshuffle"
msgstr "Перемешать"
msgid "Appearance"
msgstr "Внешний вид"
msgid "Wallpaper scaling"
msgstr "Масштабирование обоев"
msgid "Fill and crop"
msgstr "Заполнить и обрезать"
msgid "Fit with borders"
msgstr "Вписать с полями"
msgid "Assignment order"
msgstr "Порядок назначения"
msgid "Workspace 1 · monitor 1, workspace 1 · monitor 2, then workspace 2, and so on."
msgstr "Рабочее пространство 1 · монитор 1, рабочее пространство 1 · монитор 2, затем рабочее пространство 2 и так далее."
msgid "No folder selected"
msgstr "Папка не выбрана"
msgid "The selected wallpaper folder could not be read."
msgstr "Не удалось прочитать выбранную папку с обоями."
msgid "No supported images were found in the selected folder."
msgstr "В выбранной папке не найдено поддерживаемых изображений."
